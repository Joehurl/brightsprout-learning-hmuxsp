{
  "expo": {
    "name": "BrightSprout",
    "slug": "brightsprout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9F0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "app.speakbridgego",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "brightsprout",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      },
      "revenueCatApiKeyAndroid": "",
      "revenueCatApiKeyIos": "appl_XNefMGXWniaJUsCWKHoXCttxmeW",
      "revenueCatTestApiKeyAndroid": "",
      "revenueCatEntitlementId": "pro"
    },
    "ios": {
      "bundleIdentifier": "app.speakbridgego",
      "infoPlist": {
        "NSHumanReadableCopyright": "\u00a9 2025 BrightSprout",
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}